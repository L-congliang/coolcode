# DeepSeek and other OpenAI-compatible providers
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com
COOLCODE_MODEL=deepseek-chat

# Anthropic alternative
# ANTHROPIC_API_KEY=replace-with-your-api-key
# COOLCODE_MODEL=claude-sonnet-4-5

# Absolute host path to the project mounted at /workspace.
# Windows example: D:/CoolCodeWorkspace/demo-project
# Linux example: /srv/coolcode-workspace
COOLCODE_WORKSPACE=/absolute/path/to/project
